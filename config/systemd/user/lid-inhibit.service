[Unit]
Description=Prevent laptop idle, sleep and lid-close actions

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit \
    --what=idle:sleep:handle-lid-switch \
    --who=lid-inhibit \
    --why="Lid mode enabled" \
    --mode=block \
    /usr/bin/sleep infinity

[Install]
WantedBy=default.target
