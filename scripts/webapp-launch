#!/bin/bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: $0 URL" >&2
    exit 2
fi

URL="$1"

# Derive a unique profile name from the website
HOST="${URL#*://}"
HOST="${HOST%%/*}"
PROFILE_NAME=$(printf '%s' "$HOST" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9.-')

PROFILE_DIR="$HOME/.local/share/firefox-webapps/$PROFILE_NAME"

mkdir -p "$PROFILE_DIR/chrome"

# Enable custom Firefox CSS
cat > "$PROFILE_DIR/user.js" <<'EOF'
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("browser.tabs.drawInTitlebar", true);
EOF

# Hide Firefox's browser toolbar and tab bar
cat > "$PROFILE_DIR/chrome/userChrome.css" <<'EOF'
#navigator-toolbox {
    visibility: collapse !important;
}
EOF

# Launch an independent Firefox instance
exec firefox \
    --no-remote \
    --profile "$PROFILE_DIR" \
    --new-window "$URL"
