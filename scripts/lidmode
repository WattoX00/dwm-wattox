#!/usr/bin/env bash

SERVICE="lid-inhibit.service"
XSET_HELPER="$HOME/.local/bin/lid-xset"

on() {
  systemctl --user start "$SERVICE" || return 1
  "$XSET_HELPER" on
  echo "ON"
}

off() {
  systemctl --user stop "$SERVICE" || return 1
  "$XSET_HELPER" off
  echo "OFF"
}

status() {
  if systemctl --user is-active --quiet "$SERVICE"; then
    echo "ON"
  else
    echo "OFF"
  fi
}

case "${1:-toggle}" in
on)  on ;;
off) off ;;
toggle)
  if systemctl --user is-active --quiet "$SERVICE"; then off; else on; fi
  ;;
status) status ;;
*)
  echo "Usage: lidmode {on|off|toggle|status}" >&2
  exit 1
  ;;
esac
