#!/usr/bin/env bash

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/nightshift"
LOCATION_FILE="$HOME/.config/nightshift/location"

LOCATION=""

get_mode() {
  if [[ -r "$STATE_FILE" ]]; then
    cat "$STATE_FILE"
  else
    echo "off"
  fi
}

stop_redshift() {
  pkill -x redshift 2>/dev/null || true
}

set_mode() {
  local mode="$1"

  if ! command -v redshift >/dev/null 2>&1; then
    echo "nightshift: redshift not installed" >&2
    return 1
  fi

  mkdir -p "$STATE_DIR" || return 1

  case "$mode" in
  auto)
    if [[ ! -r "$LOCATION_FILE" ]]; then
      echo "nightshift: location file missing" >&2
      return 1
    fi

    LOCATION="$(tr -d '[:space:]' <"$LOCATION_FILE")"

    if [[ ! "$LOCATION" =~ ^-?[0-9]+([.][0-9]+)?:-?[0-9]+([.][0-9]+)?$ ]]; then
      echo "nightshift: invalid location: $LOCATION" >&2
      return 1
    fi

    stop_redshift

    setsid -f redshift \
      -m randr \
      -l "$LOCATION" \
      -t 5500:3000 \
      </dev/null >/dev/null 2>&1

    ;;

  night)
    stop_redshift
    redshift -O 3000 || return 1
    ;;

  off)
    stop_redshift
    redshift -x || return 1
    ;;

  *)
    echo "Unknown mode: $mode" >&2
    return 1
    ;;
  esac

  printf '%s\n' "$mode" >"$STATE_FILE"
}

case "${1:-toggle}" in
auto | night | off)
  set_mode "$1"
  ;;

on)
  set_mode night
  ;;

toggle)
  case "$(get_mode)" in
  off) set_mode night ;;
  *) set_mode off ;;
  esac
  ;;

status)
  get_mode
  ;;

*)
  echo "Usage: nightshift {auto|night|on|off|toggle|status}" >&2
  exit 1
  ;;
esac
