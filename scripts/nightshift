#!/usr/bin/env bash

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/nightshift"

mkdir -p "$STATE_DIR"

# Your existing Redshift configuration
AUTO_CMD=(
    redshift
    -m randr
    -l 0.0:0.0
    -t 5500:3000
    -r
)

get_mode() {
    cat "$STATE_FILE" 2>/dev/null || echo "auto"
}

set_mode() {
    local mode="$1"

    # Stop any existing automatic Redshift instance
    pkill -x redshift 2>/dev/null || true

    case "$mode" in
        auto)
            # Restore automatic day/night adjustment
            setsid -f "${AUTO_CMD[@]}" \
                </dev/null >/dev/null 2>&1
            ;;

        night)
            # Force night temperature
            redshift -P -O 3000
            ;;

        off)
            # Force neutral temperature
            redshift -P -O 6500
            ;;

        *)
            echo "Unknown mode: $mode"
            return 1
            ;;
    esac

    printf '%s\n' "$mode" > "$STATE_FILE"
}

case "${1:-toggle}" in
    auto|night|off)
        set_mode "$1"
        ;;

    toggle)
        case "$(get_mode)" in
            auto)  set_mode night ;;
            night) set_mode off ;;
            off)   set_mode auto ;;
            *)     set_mode auto ;;
        esac
        ;;

    status)
        get_mode
        ;;

    *)
        echo "Usage: nightshift {auto|night|off|toggle|status}"
        exit 1
        ;;
esac